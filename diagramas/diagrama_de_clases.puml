@startuml name diagrama de clases

enum tipoTransaccion{
    COMPRA
    VENTA
}

class Inversor{
    - nombre: string
    - email: string
    - contraseña: string
    - saldoVirtual: number
    - portafolio: Portafolio
    - saldoCaucionado: number

    - validarTarjeta(tarjeta: number, fechaVencimiento: Date, cvc: number): void
    + consultarPortafolio(): Portafolio
    + ingresarFondos(monto: number, tarjeta: number, fechaVencimiento: Date, cvc: number): void
    + colocarCaucion(monto: number, dias: number): void
    + listarActivos(): activo[]
}

class Administrador extends Inversor{
    + crearActivo(nombre: string, precio: number): Activo
    + listarUsuarios(): Inversor[]
}

class Portafolio{
    - transacciones: Transaccion[]
    - tenenciaActivo: TenenciaActivo[]
    - valorPortafolio: number
}

class TenenciaActivo{
    - cantidad: number
    - activo: Activo
}

class Transaccion{
    - id: number
    - ticker: string
    - tipo: tipoTransaccion
    - cantidad: number
    - precioEjecutado: number
    - fecha: Date
}

class Activo{
    - id: number
    - nombre: string
    - ticker: string
    - precio: number
    - precioInicial: number
    - transacciones: Transaccion[]
}

class Simulador{
    + cargarActivosInicailes()
    + simularMercado()
}

class Sistema{
    + procesarCompra(dto: CompraActivoDto, inversorId: number)
    + procesarVenta(dto: CompraActivoDto, inversorId: number)
}


note right of Simulador 
    simularMercado(){
        ... decision del activo a operar
        ... decision de compra/venta
        ... decision de la cantidad
        ... creacion de la transaccion 
    }
end note

note left of Inversor 
    colocarCaucion(){
        ... logica de rebote si excede a saldo Virtual
        ... modificacion a saldo virtual
        ... incrementacion de saldo caucionado
    }
    ingresarFondos(){
        this.validarTarjeta()
        ... modificar saldoVirtual
    }
end note

Inversor o-- Portafolio 
Portafolio *-- Transaccion
Transaccion .r.> tipoTransaccion
Administrador ..> Activo
Portafolio o-- TenenciaActivo
TenenciaActivo --> Activo
Simulador *-l- Activo
Sistema *-d- Activo

@enduml